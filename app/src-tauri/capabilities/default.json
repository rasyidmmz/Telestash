{
  "identifier": "default",
  "description": "Standard permissions for TeleStash",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "store:default",
    "updater:default",
    "process:default",
    "clipboard-manager:allow-write-text",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
